{
  "schema_version": 2,
  "description": "Enforceable colour policy. POLICY ONLY. Role-to-hex data lives in color_roles.json; duplicating it here is what let the two files drift. Every rule below is checked by validate_color_roles.sh, which install.sh and install_hook.sh invoke before any write is committed.",
  "enforced": true,
  "rules": {
    "require_hex_format": {
      "enabled": true,
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "reason": "Roles must carry a full 6-digit hex value so 24-bit ANSI conversion is unambiguous."
    },
    "forbid_pure_white": {
      "enabled": true,
      "value": "#FFFFFF",
      "reason": "Pure white collapses against light terminal themes and defeats visual hierarchy."
    },
    "forbid_pure_black": {
      "enabled": true,
      "value": "#000000",
      "reason": "Pure black collapses against dark terminal themes."
    },
    "forbid_duplicate_roles": {
      "enabled": true,
      "reason": "Two entries with the same role name make lookup order-dependent."
    },
    "forbid_duplicate_hex": {
      "enabled": false,
      "reason": "Shared colours are legal but usually unintended. Off by default; enable here, or pass --strict, to make it a hard failure."
    },
    "require_fields": {
      "enabled": true,
      "fields": [
        "role",
        "category",
        "hex_value",
        "hierarchy"
      ],
      "reason": "Downstream tooling indexes on these four fields."
    },
    "require_luminance_range": {
      "enabled": true,
      "min": 24,
      "max": 247,
      "reason": "Absolute perceived luminance guard, independent of background. Catches near-black and near-white even if someone sets an unusual background. require_contrast_ratio is the rule that reflects real legibility."
    },
    "require_contrast_ratio": {
      "enabled": true,
      "background": "#1E1E1E",
      "min_ratio": 4.5,
      "reason": "WCAG 2.1 relative contrast against the declared terminal background. 4.5:1 is the body-text floor; 3.0 is large/bold only and 7.0 is AAA. Set background to your actual terminal colour - a light terminal needs darker roles, and this rule will say so."
    }
  },
  "required_roles": [
    "directory",
    "files",
    "scripts",
    "links",
    "prompt",
    "errors",
    "warnings",
    "success"
  ],
  "allowed_hierarchies": [
    "parent",
    "child",
    "cousin",
    "alert",
    "feedback",
    "language",
    "runtime"
  ],
  "reserved_roles": {
    "prompt": "Consumed by colors.source.sh to build PS1.",
    "errors": "Consumed by the error() helper.",
    "warnings": "Consumed by the warn() helper.",
    "success": "Consumed by the success() helper."
  }
}
