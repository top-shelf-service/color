# shellcheck shell=bash
# Public entry point; all existing renderer functions remain available.
color() {
  local sub="${1:-help}"
  if [ "$#" -gt 0 ]; then shift; fi
  case "$sub" in
    aliases)
      if [ "$#" -eq 0 ]; then
        __color_aliases inspect
      elif [ "$#" -eq 1 ] && [ "$1" = update ]; then
        __color_aliases update
      else
        printf 'Usage: color aliases [update]\n' >&2
        return 2
      fi
      return ;;
    man|search) __color_vocabulary "$sub" "$@"; return ;;
    doctor)
      if [ "$#" -eq 0 ]; then
        __color_diagnose || return
        color_doctor
      elif [ "$#" -eq 1 ] && [ "$1" = --fix ]; then
        __color_repair_reload
      else
        printf 'Usage: color doctor [--fix]\n' >&2
        return 2
      fi
      return ;;

  esac
  if [ "$sub" = restore ]; then
    if [ "$#" -ne 1 ]; then
      printf 'Usage: color restore <backup-runtime-path>\n' >&2
      return 2
    fi
  elif [ "$#" -ne 0 ]; then
    printf 'color: unexpected arguments; see color help\n' >&2
    return 2
  fi
  case "$sub" in
    help|-h|--help) printf '%s\n' 'Usage: color {update|backup|restore <backup-runtime-path>|help|version|list|validate}' '       color man [term]' '       color search <keyword>' '       color doctor [--fix]' '       color reload' '       color aliases [update]' ;;
    version) cat "$COLOR_RUNTIME_HOME/.version" ;;
    list) color_roles ;;
    validate) color_validate ;;
    backup) __color_runtime_transaction backup ;;
    reload) __color_repair_reload ;;
    update|restore)
      __color_runtime_transaction "$sub" "$@" || return
      # Reload in the calling shell, not a child.
      # shellcheck source=/dev/null
      . "$COLOR_RUNTIME_HOME/colors.source.sh" &&
        [ "$COLOR_SYSTEM_READY" -eq 1 ]
      ;;
    *) printf 'color: unknown command %s; see color help\n' "$sub" >&2; return 2 ;;
  esac
}


# Opt-in managed Color shortcuts. The existing alias template is reference
# data here: never source it or the personal file during inspection/update.
# A mkdir marker is durable, and shares the runtime transaction lock.
__color_alias_enable() (
  local rt="$COLOR_RUNTIME_HOME" lock="$COLOR_RUNTIME_HOME.update-lock" marker
  marker="$rt/aliases.enabled"
  mkdir -- "$lock" || { echo 'color aliases: runtime transaction lock held' >&2; return 1; }
  trap 'rmdir -- "$lock"' EXIT
  if [ -L "$marker" ] || { [ -e "$marker" ] && ! [ -d "$marker" ]; }; then
    echo 'color aliases: unsafe enable marker' >&2
    return 1
  fi
  [ -d "$marker" ] || mkdir -- "$marker"
)

__color_aliases() {
  local mode="$1" rt="$COLOR_RUNTIME_HOME" reference personal marker name line actual rc
  local re="^alias (colorreload|colortest|colorroles)='([^']*)'$"
  local -a names=(colorreload colortest colorroles)
  local -A desired=() available=()
  reference="$rt/alias-reference.txt"
  personal="$HOME/.bash_aliases"
  marker="$rt/aliases.enabled"
  if [[ "$rt" != /* ]] || ! [ -d "$rt" ] || [ -L "$rt" ] ||
     [ "$(readlink -f -- "$rt")" != "$rt" ] ||
     [ -L "$reference" ] || ! [ -f "$reference" ] || ! [ -r "$reference" ] ||
     [ -L "$marker" ] || { [ -e "$marker" ] && ! [ -d "$marker" ]; }; then
    echo 'color aliases: unsafe or missing runtime reference/marker' >&2
    return 1
  fi
  if [ -L "$personal" ] || { [ -e "$personal" ] &&
       { ! [ -f "$personal" ] || ! [ -r "$personal" ]; }; }; then
    echo 'color aliases: unsafe or unreadable personal alias path' >&2
    return 1
  fi
  # Syntax check only; no BASH_ENV startup code and no personal evaluation.
  if [ -f "$personal" ] && ! env -u BASH_ENV -u ENV bash --noprofile --norc -n -- "$personal"; then
    echo 'color aliases: personal alias syntax invalid; no changes made' >&2
    return 1
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      'alias colorreload='*|'alias colortest='*|'alias colorroles='*)
        if ! [[ "$line" =~ $re ]]; then
          echo 'color aliases: invalid shipped alias declaration' >&2
          return 1
        fi
        name="${BASH_REMATCH[1]}"
        if [[ -n "${desired[$name]+x}" ]] || [ -z "${BASH_REMATCH[2]}" ]; then
          echo 'color aliases: duplicate or empty shipped alias' >&2
          return 1
        fi
        desired[$name]="${BASH_REMATCH[2]}"
        ;;
    esac
  done < "$reference"
  for name in "${names[@]}"; do
    if [[ -z "${desired[$name]+x}" ]]; then
      printf 'color aliases: missing shipped definition: %s\n' "$name" >&2
      return 1
    fi
  done
  if [ "$mode" = inspect ]; then
    if [ -d "$marker" ]; then echo 'Managed Color shortcuts: enabled'
    else echo 'Managed Color shortcuts: not enabled'; fi
  fi
  for name in "${names[@]}"; do
    if actual=$(builtin alias "$name" 2>/dev/null); then
      if [ "$actual" = "alias $name='${desired[$name]}'" ]; then
        [ "$mode" = startup ] || printf 'PRESENT %s (unchanged)\n' "$name"
      else
        printf 'CONFLICT %s: existing shell alias retained\n' "$name" >&2
      fi
    elif builtin type -t "$name" >/dev/null 2>&1; then
      printf 'CONFLICT %s: existing command/function retained\n' "$name" >&2
    else
      # Before startup we cannot know whether a personal declaration has
      # already been evaluated. Conservatively skip any literal reference.
      # At startup the personal file has already been loaded normally.
      if [ "$mode" != startup ] && [ -f "$personal" ]; then
        rc=0
        grep -Fq -- "$name" "$personal" || rc=$?
        case "$rc" in
          0) printf 'POSSIBLE CONFLICT %s: personal file references name; deferred until shell startup\n' "$name" >&2; continue ;;
          1) ;;
          *) echo 'color aliases: cannot inspect personal file' >&2; return 1 ;;
        esac
      fi
      available[$name]=1
      [ "$mode" != inspect ] || printf 'AVAILABLE %s = %s\n' "$name" "${desired[$name]}"
    fi
  done
  if [ "$mode" = inspect ]; then
    echo 'Inspection covers active shell definitions and literal personal-file references; dynamic shell code is not evaluated.'
    return 0
  fi
  if [ "$mode" = update ]; then
    __color_alias_enable || return
  fi
  for name in "${names[@]}"; do
    if [[ -n "${available[$name]+x}" ]]; then
      builtin alias "$name=${desired[$name]}" || return
      [ "$mode" = startup ] || printf 'ADDED %s to current shell\n' "$name"
    fi
  done
  if [ "$mode" = update ]; then
    echo 'Managed shortcuts enabled; personal alias file unchanged.'
    echo 'For future shells, run the normal installer once if the startup hook is absent (not --skip-aliases).'
    echo 'Existing shell definitions take precedence; dynamic personal code is not evaluated here.'
  fi
}

# Invoked only by the managed startup block, after its normal personal alias
# sourcing step. Older startup blocks require a normal reinstall once.
__color_aliases_startup() {
  local marker="$COLOR_RUNTIME_HOME/aliases.enabled"
  if [ -e "$marker" ] || [ -L "$marker" ]; then
    __color_aliases startup
  fi
}

# Read the shipped reference, not the checkout or the mutable role schema.
__color_vocabulary() {
  local mode="$1" query vocab result
  shift
  if [ "$#" -gt 1 ] ||
     { [ "$mode" = search ] && [ "$#" -eq 0 ]; } ||
     { [ "$#" -eq 1 ] && [[ ! "$1" =~ [^[:space:]] ]]; }; then
    if [ "$mode" = man ]; then
      echo 'Usage: color man [term] (quote multiword terms)' >&2
    else
      echo 'Usage: color search <keyword> (quote multiword keywords)' >&2
    fi
    return 2
  fi
  query="${1:-}"
  vocab="$COLOR_RUNTIME_HOME/vocabulary.json"
  if [ ! -r "$vocab" ]; then
    echo 'color: installed vocabulary unavailable; run color update or reinstall' >&2
    return 1
  fi
  if ! result=$(jq -r --arg mode "$mode" --arg query "$query" '
    def normalized: ascii_downcase | gsub("[_.[:space:]-]+"; "");
    def describe($v):
      . as $t |
      ($v.classification.role_to_term | to_entries |
        map(select(.value == $t.id) | .key) | sort) as $roles |
      "\(.id) [\(.domain)]\n  Meaning: \(.definition)\n  Example: \(.example)"
      + (if (.aliases | length) > 0 then "\n  Aliases: \(.aliases | join(", "))" else "" end)
      + (if ($roles | length) > 0 then "\n  Color roles: \($roles | join(", "))" else "" end);
    . as $v |
    if $mode == "man" then
      if $query == "" then
        "Color vocabulary v\(.version) — use color man <term> or color search <keyword>",
        (.domains[] | .id as $d |
          "\n=== \(.title) ===",
          ($v.terms[] | select(.domain == $d) | describe($v)))
      else
        ($query | normalized) as $needle |
        .terms[] | select(any(([.id] + .aliases)[]; normalized == $needle)) |
        describe($v)
      end
    else
      ($query | ascii_downcase) as $needle |
      ($query | normalized) as $key |
      .terms[] |
      select(
        any(([.id, (.id | gsub("_"; " ")), .domain, .definition, .example] + .aliases)[];
            ascii_downcase | contains($needle))
        or ($key != "" and any(([.id] + .aliases)[]; normalized | contains($key)))
      ) |
      "\(.id) — \(.definition)"
    end
  ' "$vocab"); then
    echo 'color: cannot read installed vocabulary; run color update or reinstall' >&2
    return 1
  fi
  if [ -z "$result" ]; then
    if [ "$mode" = man ]; then
      printf 'color man: unknown term "%s"; try color search\n' "$query" >&2
    else
      printf 'color search: no matches for "%s"\n' "$query" >&2
    fi
    return 1
  fi
  printf '%s\n' "$result"
}

# Read-only, observational diagnosis. Status 3 means only the generated
# cache needs repair; status 1 means repair is not known to be safe.
# Never source the cache or run the loader during diagnosis.
__color_diagnose() {
  local mode="${1:-observe}" verbosity="${2:-verbose}" rt="$COLOR_RUNTIME_HOME" lock f nonregular expected rc=0
  lock="$rt.update-lock"
  if [ "$mode" != locked ] && { [ -e "$lock" ] || [ -L "$lock" ]; }; then
    echo 'color doctor: UNKNOWN: transaction lock present; if interrupted, recover manually' >&2
    return 1
  fi
  if ! [ -d "$rt" ] || [ -L "$rt" ] || [ "$(readlink -f "$rt")" != "$rt" ]; then
    echo 'color doctor: UNKNOWN: runtime missing or not a real absolute directory; manual recovery required' >&2
    return 1
  fi
  if [ "${COLOR_ROLE_SCHEMA_PATH:-}" != "$rt/color_roles.json" ] ||
     [ "${COLOR_LAWS_PATH:-}" != "$rt/laws/color/color-laws.json" ] ||
     [ "${COLOR_CACHE_FILE:-}" != "$rt/cache/roles.sh" ]; then
    echo 'color doctor: UNKNOWN: external runtime paths; refusing repair' >&2
    return 1
  fi
  nonregular=$(find "$rt" ! -type f ! -type d -print -quit) || return 1
  if [ -n "$nonregular" ]; then
    echo 'color doctor: UNKNOWN: nonregular runtime entry; manual inspection required' >&2
    return 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo 'color doctor: UNKNOWN: jq unavailable' >&2
    return 1
  fi
  for f in color_roles.json laws/color/color-laws.json colors.source.sh \
           color-cli.sh install_hook.sh validate_color_roles.sh vocabulary.json .version; do
    if ! [ -f "$rt/$f" ] || ! [ -r "$rt/$f" ] || ! [ -s "$rt/$f" ]; then
      printf 'color doctor: UNKNOWN: missing, empty or unreadable %s; manual recovery required\n' "$f" >&2
      return 1
    fi
  done
  if ! [ -x "$rt/validate_color_roles.sh" ] || ! [ -x "$rt/install_hook.sh" ]; then
    echo 'color doctor: UNKNOWN: managed executable missing permission; manual recovery required' >&2
    return 1
  fi
  for f in colors.source.sh color-cli.sh install_hook.sh validate_color_roles.sh; do
    if ! bash -n "$rt/$f"; then
      printf 'color doctor: UNKNOWN: invalid shell syntax in %s; manual recovery required\n' "$f" >&2
      return 1
    fi
  done
  if ! jq -e 'type == "object" and (.schema_version | type == "number" and . >= 2)' \
       "$COLOR_LAWS_PATH" >/dev/null ||
     ! jq -e 'type == "object" and (.terms | type == "array" and length > 0)
       and (.domains | type == "array" and length > 0)
       and (.classification.role_to_term | type == "object")' "$rt/vocabulary.json" >/dev/null ||
     ! color_validate >/dev/null; then
    echo 'color doctor: UNKNOWN: policy, role or vocabulary validation failed; manual recovery required' >&2
    return 1
  fi
  if { [ -e "$rt/cache" ] && ! [ -d "$rt/cache" ]; } ||
     { [ -e "$COLOR_CACHE_FILE" ] && { ! [ -f "$COLOR_CACHE_FILE" ] || ! [ -r "$COLOR_CACHE_FILE" ]; }; }; then
    echo 'color doctor: UNKNOWN: unsafe cache layout or unreadable cache' >&2
    return 1
  fi
  expected=$(__color_emit_cache) || {
    echo 'color doctor: UNKNOWN: cannot generate expected cache bytes' >&2
    return 1
  }
  if [ ! -f "$COLOR_CACHE_FILE" ]; then
    rc=3
  else
    cmp -s "$COLOR_CACHE_FILE" <(printf '%s\n' "$expected") || rc=$?
    case "$rc" in
      0) if [ "$COLOR_ROLE_SCHEMA_PATH" -nt "$COLOR_CACHE_FILE" ]; then rc=3; fi ;;
      1) rc=3 ;;
      *) echo 'color doctor: UNKNOWN: cache comparison failed' >&2; return 1 ;;
    esac
  fi
  if [ "$mode" != locked ] && { [ -e "$lock" ] || [ -L "$lock" ]; }; then
    echo 'color doctor: UNKNOWN: runtime transaction in progress' >&2
    return 1
  fi
  if [ "$rc" -eq 3 ]; then
    if [ "$verbosity" != quiet ]; then
      echo 'color doctor: REPAIRABLE: generated role cache missing or stale; run color doctor --fix' >&2
    fi
    return 3
  fi
  if [ "$verbosity" != quiet ]; then
    echo 'color doctor: HEALTHY: required files present, policy valid, cache current (not a code-integrity attestation)'
  fi
}

# A verified cache snapshot is returned under the existing transaction lock.
# Reload the calling shell from those bytes without a second disk mutation.
__color_repair_reload() {
  local snapshot verbosity="${1:-verbose}"
  snapshot=$(__color_runtime_transaction repair "$verbosity") || return 1
  __color_read_cache /dev/stdin <<< "$snapshot" || return 1
  if [ "$verbosity" != quiet ]; then
    echo 'Color cache verified; calling shell reloaded.'
  fi
}

# Stage the entire existing runtime on the same filesystem. The live copy is
# untouched until the candidate installer and validation both succeed.
__color_runtime_transaction() (
  set -euo pipefail
  local op="$1" snapshot="${2:-}" rt repo work='' stage backup='' revision version lock committed=false
  local backup_dir digest expected nonregular prior_valid=false
  rt="$COLOR_RUNTIME_HOME"
  [ -d "$rt" ] && [ ! -L "$rt" ] && [ "$(readlink -f "$rt")" = "$rt" ] ||
    { echo 'color: runtime must be a real absolute directory' >&2; return 1; }
  [ "${COLOR_ROLE_SCHEMA_PATH:-}" = "$rt/color_roles.json" ] &&
    [ "${COLOR_LAWS_PATH:-}" = "$rt/laws/color/color-laws.json" ] ||
    { echo 'color: external schema/law paths are not supported' >&2; return 1; }
  if [ "$op" = update ]; then
    [ -r "$rt/.update-repo" ] || { echo 'color update: run install.sh once from your trusted Git checkout' >&2; return 1; }
    IFS= read -r repo < "$rt/.update-repo"
    [ "$(git -C "$repo" rev-parse --show-toplevel)" = "$repo" ] ||
      { echo 'color update: configured checkout is unavailable' >&2; return 1; }
  fi
  lock="$rt.update-lock"
  mkdir -- "$lock" || { echo 'color: another runtime transaction or interrupted transaction owns the lock' >&2; return 1; }
  # Restore the prior runtime on normal failure or catchable interruption.
  # Keep the backup and lock if recovery itself fails.
  # Invoked indirectly by the EXIT trap below.
  # shellcheck disable=SC2329
  __color_update_cleanup() {
    local status=$?
    trap - EXIT INT TERM HUP
    if ! $committed && [ -n "$backup" ] && [ -d "$backup" ]; then
      if [ -e "$rt" ]; then
        mv -- "$rt" "$work/rejected" || { printf 'RECOVERY REQUIRED: prior runtime at %s\n' "$backup" >&2; exit 2; }
      fi
      mv -- "$backup" "$rt" || { printf 'RECOVERY REQUIRED: restore %s to %s\n' "$backup" "$rt" >&2; exit 2; }
      if $prior_valid; then
        "$rt/validate_color_roles.sh" "$rt/color_roles.json" "$rt/laws/color/color-laws.json" >/dev/null ||
          { echo 'RECOVERY REQUIRED: restored runtime did not validate' >&2; exit 2; }
      fi
    fi
    if [ -n "$work" ]; then rm -rf -- "$work"; fi
    rmdir -- "$lock"
    exit "$status"
  }
  trap __color_update_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  if [ "$op" = repair ]; then
    local diagnosis=0
    __color_diagnose locked "$snapshot" >&2 || diagnosis=$?
    case "$diagnosis" in
      0) ;;
      3)
        __color_compile_cache || { echo 'color doctor: cache repair failed' >&2; return 1; }
        __color_diagnose locked "$snapshot" >&2 || return 1
        ;;
      *) return 1 ;;
    esac
    cat -- "$COLOR_CACHE_FILE"
    return
  fi
  # Check after acquiring the lock; symlinks or special files make a
  # snapshot unsafe. A failed inventory is not an empty inventory.
  nonregular=$(find "$rt" ! -type f ! -type d -print -quit) || return 1
  [ -z "$nonregular" ] ||
    { echo "color $op: nonregular entry inside runtime; refusing to proceed" >&2; return 1; }
  if [ "$op" != update ]; then
    # Missing/legacy policy would silently select validator defaults.
    jq -e 'type == "object" and (.schema_version | type == "number" and . >= 2)' \
      "$COLOR_LAWS_PATH" >/dev/null || return 1
  fi
  if [ "$op" = restore ]; then
    # An invalid live role file is a legitimate reason to restore.
    if color_validate >/dev/null 2>&1; then prior_valid=true; fi
  elif [ "$op" = backup ]; then
    color_validate >/dev/null || return 1
    prior_valid=true
  else
    color_validate || return 1
    prior_valid=true
  fi
  work=$(mktemp -d "$(dirname "$rt")/.color-update.XXXXXXXX") || return 1
  stage="$work/runtime"
  cp -a -- "$rt" "$stage" || return 1
  diff -qr -- "$rt" "$stage" || return 1
  if [ "$op" = backup ]; then
    # Same retained-runtime layout used by update. Verify the copied roles
    # with the installed validator and record their checksum, not a second
    # archive format. No live files are changed.
    "$rt/validate_color_roles.sh" "$stage/color_roles.json" "$COLOR_LAWS_PATH" >/dev/null || return 1
    backup_dir=$(mktemp -d "$(dirname "$rt")/.color-backup.XXXXXXXX") || return 1
    digest=$(sha256sum < "$stage/color_roles.json") || return 1
    printf '%s\n' "${digest%% *}" > "$backup_dir/roles.sha256" || return 1
    mv -- "$stage" "$backup_dir/runtime" || return 1
    printf '%s\n' "$backup_dir/runtime"
    return 0
  fi
  if [ "$op" = restore ]; then
    # Restore only role data, never code, policy, cache or shell startup
    # from an old snapshot. Accept only a real retained sibling runtime.
    case "$snapshot" in
      "$(dirname "$rt")"/.color-backup.*/runtime) ;;
      *) echo 'color restore: expected a retained backup runtime path' >&2; return 1 ;;
    esac
    [ -d "$snapshot" ] && [ "$(readlink -f "$snapshot")" = "$snapshot" ] &&
      [ "$(dirname "$(dirname "$snapshot")")" = "$(dirname "$rt")" ] &&
      [ -f "$snapshot/color_roles.json" ] && [ ! -L "$snapshot/color_roles.json" ] ||
      { echo 'color restore: invalid backup path or role file' >&2; return 1; }
    cp -- "$snapshot/color_roles.json" "$stage/color_roles.json" || return 1
    if [ -e "$(dirname "$snapshot")/roles.sha256" ] || [ -L "$(dirname "$snapshot")/roles.sha256" ]; then
      [ -f "$(dirname "$snapshot")/roles.sha256" ] && [ ! -L "$(dirname "$snapshot")/roles.sha256" ] || return 1
      IFS= read -r expected < "$(dirname "$snapshot")/roles.sha256" || return 1
      digest=$(sha256sum < "$stage/color_roles.json") || return 1
      [ "$expected" = "${digest%% *}" ] || { echo 'color restore: backup checksum mismatch' >&2; return 1; }
    fi
    "$rt/validate_color_roles.sh" "$stage/color_roles.json" "$COLOR_LAWS_PATH" || return 1
    rm -f -- "$stage/cache/roles.sh" || return 1
  else
    git -C "$repo" fetch origin refs/heads/main || return 1
    revision=$(git -C "$repo" rev-parse --verify 'FETCH_HEAD^{commit}') || return 1
    mkdir "$work/source"
    git -C "$repo" archive "$revision" | tar -xf - -C "$work/source" || return 1
    version=$(bash "$work/source/install.sh" --version) || return 1
    if [ -r "$rt/.update-revision" ] && [ "$(cat "$rt/.update-revision")" = "$revision" ]; then
      printf 'Color %s is already current.\n' "$(cat "$rt/.version")"
      return 0
    fi
    env -u COLOR_RUNTIME_HOME -u COLOR_ROLE_SCHEMA_PATH -u COLOR_LAWS_PATH \
      bash "$work/source/install.sh" --runtime-only --runtime-dir "$stage" || return 1
    cmp -s "$rt/color_roles.json" "$stage/color_roles.json" ||
      { echo 'color update: role data changed; candidate rejected' >&2; return 1; }
    "$stage/validate_color_roles.sh" "$stage/color_roles.json" "$stage/laws/color/color-laws.json" || return 1
    printf '%s\n' "$revision" > "$stage/.update-revision"
  fi
  backup_dir=$(mktemp -d "$(dirname "$rt")/.color-backup.XXXXXXXX") || return 1
  backup="$backup_dir/runtime"
  mv -- "$rt" "$backup" || return 1
  mv -- "$stage" "$rt" || return 1
  if ! ( unset COLOR_RUNTIME_HOME COLOR_ROLE_SCHEMA_PATH COLOR_LAWS_PATH
         # shellcheck source=/dev/null
         . "$rt/colors.source.sh" && [ "$COLOR_SYSTEM_READY" -eq 1 ] && color_validate ); then
    return 1
  fi
  committed=true
  if [ "$op" = restore ]; then
    printf 'Color roles restored. Previous runtime: %s\n' "$backup"
  else
    printf 'Color %s installed. Previous runtime: %s\n' "$version" "$backup"
  fi
)
