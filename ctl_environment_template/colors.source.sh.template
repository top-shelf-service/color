# shellcheck shell=bash
# colors.source.sh - runtime loader for the colour role schema
#
# CONTRACT
#   This file is self-locating. It derives COLOR_RUNTIME_HOME from its own
#   path, so the runtime works wherever it is deployed and does NOT depend on
#   the ~/ctl_environment compatibility symlink existing. Delete the symlink
#   and everything still works.
#
#   Resolution order for the runtime home:
#     1. the directory this file was sourced from  (authoritative)
#     2. $COLOR_RUNTIME_HOME                       (explicit override)
#     3. ${XDG_DATA_HOME:-$HOME/.local/share}/tss/color
#
#   Roles are compiled once into cache/roles.sh — a flat list of bash
#   assignments — so a normal shell start costs no jq forks at all, and
#   color_apply() is a pure-bash array lookup rather than two subprocesses.
#
#   Failure is always soft. A missing schema, absent jq, or unwritable cache
#   degrades to uncoloured output and a single warning. Sourcing this file
#   must never break a login shell.

# ---------- locate the runtime ----------
if [ -n "${BASH_SOURCE[0]:-}" ]; then
  __color_self="${BASH_SOURCE[0]}"
  # Resolve through symlinks so a link'd colors.source.sh still finds its runtime.
  if command -v readlink >/dev/null 2>&1; then
    __color_self="$(readlink -f "$__color_self" 2>/dev/null || echo "$__color_self")"
  fi
  __color_dir="$(cd -- "$(dirname -- "$__color_self")" 2>/dev/null && pwd)"
  if [ -n "$__color_dir" ] && [ -f "$__color_dir/color_roles.json" ]; then
    COLOR_RUNTIME_HOME="$__color_dir"
  fi
  unset __color_self __color_dir
fi
: "${COLOR_RUNTIME_HOME:=${XDG_DATA_HOME:-$HOME/.local/share}/tss/color}"
export COLOR_RUNTIME_HOME

COLOR_ROLE_SCHEMA_PATH="${COLOR_ROLE_SCHEMA_PATH:-$COLOR_RUNTIME_HOME/color_roles.json}"
COLOR_LAWS_PATH="${COLOR_LAWS_PATH:-$COLOR_RUNTIME_HOME/laws/color/color-laws.json}"
COLOR_CACHE_FILE="$COLOR_RUNTIME_HOME/cache/roles.sh"
export COLOR_ROLE_SCHEMA_PATH COLOR_LAWS_PATH

declare -gA COLOR_ROLE_HEX 2>/dev/null || declare -A COLOR_ROLE_HEX
declare -gA COLOR_ROLE_ANSI 2>/dev/null || declare -A COLOR_ROLE_ANSI
declare -gA COLOR_ROLE_HIERARCHY 2>/dev/null || declare -A COLOR_ROLE_HIERARCHY
COLOR_SYSTEM_READY=0

__color_warn() { [ -n "${COLOR_QUIET:-}" ] || printf '[color] %s\n' "$1" >&2; }

# ---------- hex -> 24-bit ANSI ----------
hex_to_ansi() {
  local hex="${1#\#}"
  case "$hex" in
    [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
    *) return 1 ;;
  esac
  printf '\033[38;2;%d;%d;%dm' "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))"
}

# ---------- cache compilation ----------
# The same emitter supports read-only comparison and atomic compilation.
__color_emit_cache() {
  printf '%s\n' "# color-cache-v2: generated from $COLOR_ROLE_SCHEMA_PATH - do not edit" &&
    jq -r '.[] | select(.role and .hex_value)
           | "COLOR_ROLE_HEX[\(.role|@sh)]=\(.hex_value|@sh)\nCOLOR_ROLE_HIERARCHY[\(.role|@sh)]=\((.hierarchy // "")|@sh)"' \
      "$COLOR_ROLE_SCHEMA_PATH" 2>/dev/null
}

__color_compile_cache() {
  command -v jq >/dev/null 2>&1 || return 1
  local dir; dir="$(dirname "$COLOR_CACHE_FILE")"
  mkdir -p "$dir" 2>/dev/null || return 1
  local tmp; tmp="$(mktemp "$COLOR_CACHE_FILE.XXXXXX" 2>/dev/null)" || return 1
  __color_emit_cache > "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$COLOR_CACHE_FILE" 2>/dev/null || { rm -f "$tmp"; return 1; }
  return 0
}

__color_load() {
  if [ ! -r "$COLOR_ROLE_SCHEMA_PATH" ]; then
    __color_warn "schema not found at $COLOR_ROLE_SCHEMA_PATH — colours disabled"
    return 1
  fi
  # Recompile only when the schema is newer than the cache.
  if [ ! -r "$COLOR_CACHE_FILE" ] || [ "$COLOR_ROLE_SCHEMA_PATH" -nt "$COLOR_CACHE_FILE" ] ||
     ! grep -q "^# color-cache-v2:" "$COLOR_CACHE_FILE"; then
    if ! __color_compile_cache; then
      if [ ! -r "$COLOR_CACHE_FILE" ]; then
        __color_warn "cannot compile role cache (is jq installed?) — colours disabled"
        return 1
      fi
      __color_warn "using stale role cache; run 'color_reload' after installing jq"
    fi
  fi
  __color_read_cache "$COLOR_CACHE_FILE"
}

# Load either the normal cache or the verified snapshot from a locked repair.
__color_read_cache() {
  COLOR_SYSTEM_READY=0
  COLOR_ROLE_HEX=() COLOR_ROLE_ANSI=() COLOR_ROLE_HIERARCHY=()
  # shellcheck source=/dev/null
  . "$1" || return 1
  local role
  for role in "${!COLOR_ROLE_HEX[@]}"; do
    COLOR_ROLE_ANSI["$role"]="$(hex_to_ansi "${COLOR_ROLE_HEX[$role]}" || true)"
  done
  COLOR_SYSTEM_READY=1
  return 0
}

# ---------- public API ----------
get_color_by_role() {
  [ "$COLOR_SYSTEM_READY" -eq 1 ] || return 1
  local hex="${COLOR_ROLE_HEX[$1]:-}"
  [ -n "$hex" ] || return 1
  printf '%s\n' "$hex"
}

color_apply() {
  local role="$1"; shift
  local text="$*"
  local ansi="${COLOR_ROLE_ANSI[$role]:-}"
  if [ "$COLOR_SYSTEM_READY" -eq 1 ] && [ -n "$ansi" ] && [ -t 1 ]; then
    local emphasis=''
    case "${COLOR_ROLE_HIERARCHY[$role]:-}" in
      alert|feedback) emphasis='\033[1m' ;;
    esac
    printf '%b%b%s\033[0m\n' "$emphasis" "$ansi" "$text"
  else
    printf '%s\n' "$text"
  fi
}

# Filesystem renderer: filenames express identity; classification suffixes
# inherit that color. Long-list metadata remains native ls output.
__color_ls_sgr() {
  local hex ansi
  hex="$(get_color_by_role "$1")" || return 1
  ansi="$(hex_to_ansi "$hex")" || return 1
  ansi="${ansi#$'\033['}"
  printf '%s' "${ansi%m}"
}

__color_ls_render() (
  set -o pipefail
  local di file_sgr ln sh ts js err
  local ls_bin=ls version
  # Ubuntu 26.04 ships uutils as ls and GNU ls as gnuls.
  # The ANSI rendering contract is specifically GNU Coreutils.
  if command -v gnuls >/dev/null 2>&1; then ls_bin=gnuls; fi
  version="$(command "$ls_bin" --version 2>/dev/null)" || version=''
  if [[ "$version" != *"GNU coreutils"* ]]; then
    printf '[color] GNU ls unavailable; using plain listing.\n' >&2
    command ls --color=never -alF -- "$@"
    return
  fi
  if ! di="$(__color_ls_sgr directory)" ||
     ! file_sgr="$(__color_ls_sgr files)" ||
     ! ln="$(__color_ls_sgr links)" ||
     ! sh="$(__color_ls_sgr scripts)" ||
     ! ts="$(__color_ls_sgr typescript)" ||
     ! js="$(__color_ls_sgr javascript)" ||
     ! err="$(__color_ls_sgr errors)"; then
    command ls --color=never -alF --quoting-style=shell-escape -- "$@"
    return
  fi
  # Disable attribute color overrides; permissions and -F still show them.
  # An isolated palette fixes the reset encoding and avoids ambient overrides.
  LS_COLORS="di=$di:fi=$file_sgr:ln=$ln:ex=00:su=00:sg=00:ca=00:mh=00:tw=$di:ow=$di:st=$di:pi=$file_sgr:so=$file_sgr:bd=$file_sgr:cd=$file_sgr:do=$file_sgr:or=$err:mi=$err:*.sh=$sh:*.ts=$ts:*.tsx=$ts:*.mts=$ts:*.cts=$ts:*.js=$js:*.mjs=$js:*.cjs=$js" \
    command "$ls_bin" --color=always -alF --quoting-style=shell-escape -- "$@" |
    sed -E 's/\x1b\[0m([*/@|=>])/\1\x1b[0m/g'
)

# Paths only; use native ls for arbitrary options and machine-readable output.
color_ls() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    __color_ls_render "$@"
  else
    command ls --color=never -alF --quoting-style=shell-escape -- "$@"
  fi
}

color_roles() {
  [ "$COLOR_SYSTEM_READY" -eq 1 ] || { echo "colour system not loaded" >&2; return 1; }
  local role
  for role in $(printf '%s\n' "${!COLOR_ROLE_HEX[@]}" | sort); do
    printf '%-14s %s  ' "$role" "${COLOR_ROLE_HEX[$role]}"
    color_apply "$role" "sample"
  done
}

color_reload() {
  if declare -F __color_repair_reload >/dev/null; then
    __color_repair_reload quiet
  else
    echo 'color reload: management CLI unavailable; manual recovery required' >&2
    return 1
  fi
}

# Prints everything needed to diagnose a "wrong file" or "not loading" problem
# in one shot, so a bug report never needs a second round trip.
color_doctor() {
  echo "runtime home   : $COLOR_RUNTIME_HOME"
  echo "schema         : $COLOR_ROLE_SCHEMA_PATH"
  echo "  exists       : $([ -r "$COLOR_ROLE_SCHEMA_PATH" ] && echo yes || echo NO)"
  echo "  roles        : $(command -v jq >/dev/null && jq length "$COLOR_ROLE_SCHEMA_PATH" 2>/dev/null || echo '?')"
  echo "laws           : $COLOR_LAWS_PATH"
  echo "  exists       : $([ -r "$COLOR_LAWS_PATH" ] && echo yes || echo NO)"
  echo "cache          : $COLOR_CACHE_FILE"
  echo "  exists       : $([ -r "$COLOR_CACHE_FILE" ] && echo yes || echo NO)"
  echo "loaded         : $COLOR_SYSTEM_READY  (${#COLOR_ROLE_HEX[@]} roles in memory)"
  echo "jq             : $(command -v jq || echo 'NOT FOUND') $(jq --version 2>/dev/null)"
  echo "bash           : $BASH_VERSION"
  echo "COLOR_* in env :"
  # Capture first: a pipeline's status is the last command's (sed, always 0),
  # so the old `... | sed ... || echo "(none)"` could never print "(none)".
  local _color_env
  _color_env="$(env | grep -i '^COLOR' | sed 's/^/  /' || true)"
  if [ -n "$_color_env" ]; then printf '%s\n' "$_color_env"; else echo "  (none)"; fi
}

# Enforcement is delegated to the single engine, never reimplemented here.
color_validate() {
  local v="$COLOR_RUNTIME_HOME/validate_color_roles.sh"
  if [ -x "$v" ]; then
    "$v" "$@" "$COLOR_ROLE_SCHEMA_PATH" "$COLOR_LAWS_PATH"
  else
    echo "validator not installed at $v" >&2
    return 1
  fi
}

__color_load || true

# CLI is refreshed by the existing installer, not by personal aliases.
if [ -r "$COLOR_RUNTIME_HOME/color-cli.sh" ]; then
  # shellcheck source=/dev/null
  . "$COLOR_RUNTIME_HOME/color-cli.sh"
fi

# ---------- prompt ----------
if [ -z "${COLOR_PROMPT_DISABLE:-}" ] && [ "$COLOR_SYSTEM_READY" -eq 1 ]; then
  case "$-" in
    *i*)
      __color_prompt_ansi="${COLOR_ROLE_ANSI[prompt]:-}"
      if [ -n "$__color_prompt_ansi" ]; then
        PS1="\[${__color_prompt_ansi}\]\u@\h:\w\$\[\033[0m\] "
      fi
      unset __color_prompt_ansi
      ;;
  esac
fi
