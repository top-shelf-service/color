#!/bin/bash
# colors.source.sh - Runtime loader for color role schema
#
# Loads color roles once into a Bash associative array.
# This avoids launching jq on every color_apply call.

COLOR_ROLE_SCHEMA_PATH="${COLOR_ROLE_SCHEMA_PATH:-$HOME/.color_roles.json}"

_color_abort() {
  echo "[ERROR] $1" >&2
  return 1 2>/dev/null || exit 1
}

if [ ! -f "$COLOR_ROLE_SCHEMA_PATH" ]; then
  _color_abort "color_roles.json not found at $COLOR_ROLE_SCHEMA_PATH"
fi

if ! command -v jq >/dev/null 2>&1; then
  _color_abort "jq is required but not installed."
fi

declare -gA COLOR_ROLE_HEX=()

_color_load_roles() {
  if [ "${#COLOR_ROLE_HEX[@]}" -gt 0 ]; then
    return 0
  fi

  local role=""
  local hex=""

  while IFS=$'\t' read -r role hex; do
    if [ -n "$role" ] && [ -n "$hex" ] && [ "$hex" != "null" ]; then
      COLOR_ROLE_HEX["$role"]="$hex"
    fi
  done < <(jq -r '.[] | [.role, .hex_value] | @tsv' "$COLOR_ROLE_SCHEMA_PATH")

  if [ "${#COLOR_ROLE_HEX[@]}" -eq 0 ]; then
    echo "[ERROR] No color roles loaded from $COLOR_ROLE_SCHEMA_PATH" >&2
    return 1
  fi

  return 0
}

_color_load_roles || return 1 2>/dev/null || exit 1

get_color_by_role() {
  local role="${1:-}"

  _color_load_roles || return 1

  if [ -z "$role" ]; then
    return 1
  fi

  printf '%s\n' "${COLOR_ROLE_HEX[$role]-}"
}

hex_to_ansi() {
  local hex="${1:-}"

  hex="${hex#\#}"

  if [[ ! "$hex" =~ ^[0-9A-Fa-f]{6}$ ]]; then
    return 1
  fi

  local r=$((16#${hex:0:2}))
  local g=$((16#${hex:2:2}))
  local b=$((16#${hex:4:2}))

  printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
}

color_apply() {
  local role="${1:-}"
  shift 2>/dev/null || true

  local text="$*"
  local color_hex=""
  local ansi_color=""

  color_hex="$(get_color_by_role "$role" 2>/dev/null || true)"

  if [ -n "$color_hex" ] && ansi_color="$(hex_to_ansi "$color_hex" 2>/dev/null)"; then
    printf '%b%s\033[0m\n' "$ansi_color" "$text"
  else
    printf '%s\n' "$text"
  fi
}

export COLOR_ROLE_SCHEMA_PATH
export -f _color_load_roles
export -f get_color_by_role
export -f color_apply
export -f hex_to_ansi

if [[ $- == *i* ]]; then
  PROMPT_COLOR_HEX="$(get_color_by_role prompt 2>/dev/null || true)"
  if [ -n "$PROMPT_COLOR_HEX" ]; then
    PROMPT_ANSI_COLOR="$(hex_to_ansi "$PROMPT_COLOR_HEX" 2>/dev/null || true)"
    if [ -n "$PROMPT_ANSI_COLOR" ]; then
      export PS1="\[${PROMPT_ANSI_COLOR}\]\u@\h:\w\$ \[\e[0m\]"
    fi
  fi
fi
